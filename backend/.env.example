# Application Configuration
APP_NAME="Antigravity ERP"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

# Dynamic Database Connection
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp_core
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars!
JWT_ALGO=HS256
JWT_EXPIRATION=86400
JWT_ISSUER=antigravity_erp

# CORS Allowed Origins (* for development, specific domain for production)
CORS_ALLOWED_ORIGINS=*
